
/// A rectangular region of terminal cells.
+ struct Rect {
    /// Leftmost column (0-based).
    + x: uint (0)
    /// Topmost row (0-based).
    + y: uint (0)
    /// Width in columns.
    + width: uint (0)
    /// Height in rows.
    + height: uint (0)

    /// Creates a `Rect` at `(x, y)` with the given `width` and `height`.
    + static fn new(x: uint, y: uint, width: uint, height: uint) Rect {
        return Rect { x: x, y: y, width: width, height: height }
    }

    /// Returns whether the rectangle has zero area.
    + fn is_empty() bool {
        return this.width == 0 || this.height == 0
    }

    /// Returns the exclusive right edge (`x + width`).
    + fn right() uint {
        return this.x + this.width
    }

    /// Returns the exclusive bottom edge (`y + height`).
    + fn bottom() uint {
        return this.y + this.height
    }

    /// Returns the total number of cells (`width * height`).
    + fn area() uint {
        return this.width * this.height
    }

    /// Returns whether the cell `(x, y)` lies inside this rectangle.
    + fn contains(x: uint, y: uint) bool {
        return x >= this.x && x < this.right() && y >= this.y && y < this.bottom()
    }

    /// Returns a rectangle inset by `horizontal` columns on the left and right and
    /// `vertical` rows on the top and bottom, clamped to zero size.
    + fn inner(horizontal: uint, vertical: uint) Rect {
        return this.inner_margins(vertical, horizontal, vertical, horizontal)
    }

    /// Returns a rectangle inset by individual `top`, `right`, `bottom`, and `left` margins.
    + fn inner_margins(top: uint, right: uint, bottom: uint, left: uint) Rect {
        let h_inset = left + right
        let v_inset = top + bottom
        let w = this.width > h_inset ? this.width - h_inset : 0
        let h = this.height > v_inset ? this.height - v_inset : 0
        let nx = w > 0 ? this.x + left : this.x + (left < this.width ? left : this.width)
        let ny = h > 0 ? this.y + top : this.y + (top < this.height ? top : this.height)
        return Rect { x: nx, y: ny, width: w, height: h }
    }

    /// Returns the overlapping region between `this` and `other`, or an empty `Rect`.
    + fn intersection(other: Rect) Rect {
        let x1 = this.x > other.x ? this.x : other.x
        let y1 = this.y > other.y ? this.y : other.y
        let x2 = this.right() < other.right() ? this.right() : other.right()
        let y2 = this.bottom() < other.bottom() ? this.bottom() : other.bottom()
        if x2 <= x1 || y2 <= y1 : return Rect {}
        return Rect { x: x1, y: y1, width: x2 - x1, height: y2 - y1 }
    }

    /// Returns whether two rectangles have equal position and dimensions.
    + fn equals(other: Rect) bool $eq {
        return this.x == other.x && this.y == other.y
            && this.width == other.width && this.height == other.height
    }
}

/// Decodes a single UTF-8 codepoint starting at byte `offset` in `s`.
///
/// Returns `(codepoint, byte_length)`. Invalid bytes decode as U+FFFD with length 1.
+ fn utf8_decode_at(s: String, offset: uint) (u32, uint) {
    let len = s.bytes
    if offset >= len : return (0, 0)
    let b0 = s[offset]
    if b0 < 0x80 : return (b0.to(u32), 1)

    let count: uint = 0
    let cp: u32 = 0
    let min_cp: u32 = 0
    if (b0 & 0xe0) == 0xc0 {
        count = 2
        cp = (b0 & 0x1f).to(u32)
        min_cp = 0x80
    } else if (b0 & 0xf0) == 0xe0 {
        count = 3
        cp = (b0 & 0x0f).to(u32)
        min_cp = 0x800
    } else if (b0 & 0xf8) == 0xf0 {
        count = 4
        cp = (b0 & 0x07).to(u32)
        min_cp = 0x10000
    } else {
        return (0xfffd, 1)
    }

    if offset + count > len : return (0xfffd, 1)
    let i: uint = 1
    while i < count {
        let bx = s[offset + i]
        if (bx & 0xc0) != 0x80 : return (0xfffd, 1)
        cp = (cp << 6) | (bx & 0x3f).to(u32)
        i++
    }
    if cp < min_cp || cp > 0x10ffff || (cp >= 0xd800 && cp <= 0xdfff) {
        return (0xfffd, 1)
    }
    return (cp, count)
}

/// Encodes a Unicode codepoint as a UTF-8 string.
+ fn utf8_encode(cp: u32) String {
    let out = ByteBuffer.new(4)
    if cp < 0x80 {
        out.write_byte(cp.to(u8))
    } else if cp < 0x800 {
        out.write_byte((0xc0 | (cp >> 6)).to(u8))
        out.write_byte((0x80 | (cp & 0x3f)).to(u8))
    } else if cp < 0x10000 {
        out.write_byte((0xe0 | (cp >> 12)).to(u8))
        out.write_byte((0x80 | ((cp >> 6) & 0x3f)).to(u8))
        out.write_byte((0x80 | (cp & 0x3f)).to(u8))
    } else if cp <= 0x10ffff {
        out.write_byte((0xf0 | (cp >> 18)).to(u8))
        out.write_byte((0x80 | ((cp >> 12) & 0x3f)).to(u8))
        out.write_byte((0x80 | ((cp >> 6) & 0x3f)).to(u8))
        out.write_byte((0x80 | (cp & 0x3f)).to(u8))
    } else {
        return "\u{fffd}"
    }
    return out.into_string()
}

/// Returns the terminal display width in columns of a Unicode codepoint: `0`, `1`, or `2`.
+ fn char_width(cp: u32) uint {
    if cp == 0 : return 0
    // C0 / C1 control characters
    if cp < 0x20 || (cp >= 0x7f && cp < 0xa0) : return 0
    // Common zero-width combining marks, joiners, and variation selectors
    if (cp >= 0x0300 && cp <= 0x036f)
        || (cp >= 0x1ab0 && cp <= 0x1aff)
        || (cp >= 0x1dc0 && cp <= 0x1dff)
        || (cp >= 0x200b && cp <= 0x200f)
        || (cp >= 0x202a && cp <= 0x202e)
        || (cp >= 0x2060 && cp <= 0x206f)
        || (cp >= 0x20d0 && cp <= 0x20ff)
        || (cp >= 0xfe00 && cp <= 0xfe0f)
        || (cp >= 0xfe20 && cp <= 0xfe2f)
        || cp == 0xfeff
    {
        return 0
    }
    // East Asian Wide / Fullwidth and common wide Emoji blocks
    if (cp >= 0x1100 && cp <= 0x115f)
        || cp == 0x2329 || cp == 0x232a
        || (cp >= 0x231a && cp <= 0x231b)
        || (cp >= 0x23e9 && cp <= 0x23ec)
        || cp == 0x23f0 || cp == 0x23f3
        || (cp >= 0x25fd && cp <= 0x25fe)
        || (cp >= 0x2614 && cp <= 0x2615)
        || (cp >= 0x2648 && cp <= 0x2653)
        || cp == 0x267f || cp == 0x2693 || cp == 0x26a1
        || (cp >= 0x26aa && cp <= 0x26ab)
        || (cp >= 0x26bd && cp <= 0x26be)
        || (cp >= 0x26c4 && cp <= 0x26c5)
        || cp == 0x26ce || cp == 0x26d4 || cp == 0x26ea
        || (cp >= 0x26f2 && cp <= 0x26f3)
        || cp == 0x26f5 || cp == 0x26fa || cp == 0x26fd
        || cp == 0x2705 || (cp >= 0x270a && cp <= 0x270b)
        || cp == 0x2728 || cp == 0x274c || cp == 0x274e
        || (cp >= 0x2753 && cp <= 0x2755) || cp == 0x2757
        || (cp >= 0x2795 && cp <= 0x2797) || cp == 0x27b0 || cp == 0x27bf
        || (cp >= 0x2e80 && cp <= 0x303e)
        || (cp >= 0x3041 && cp <= 0x33ff)
        || (cp >= 0x3400 && cp <= 0x4dbf)
        || (cp >= 0x4e00 && cp <= 0xa4cf)
        || (cp >= 0xa960 && cp <= 0xa97c)
        || (cp >= 0xac00 && cp <= 0xd7a3)
        || (cp >= 0xf900 && cp <= 0xfaff)
        || (cp >= 0xfe10 && cp <= 0xfe19)
        || (cp >= 0xfe30 && cp <= 0xfe6b)
        || (cp >= 0xff01 && cp <= 0xff60)
        || (cp >= 0xffe0 && cp <= 0xffe6)
        || (cp >= 0x1f300 && cp <= 0x1f64f)
        || (cp >= 0x1f680 && cp <= 0x1f6ff)
        || (cp >= 0x1f900 && cp <= 0x1f9ff)
        || (cp >= 0x1fa70 && cp <= 0x1faff)
        || (cp >= 0x20000 && cp <= 0x3fffd)
    {
        return 2
    }
    return 1
}

/// Returns the terminal display width in columns of a UTF-8 string.
+ fn string_width(s: String) uint {
    let total: uint = 0
    let pos: uint = 0
    let len = s.bytes
    while pos < len {
        let cp, n = utf8_decode_at(s, pos)
        if n == 0 : break
        total += char_width(cp)
        pos += n
    }
    return total
}

/// Returns the display width of a single cell symbol (`1` or `2`).
fn symbol_width(sym: String) uint {
    if sym.bytes == 0 : return 1
    let w = string_width(sym)
    return w == 0 ? 1 : (w > 2 ? 2 : w)
}

/// A single styled cell in a terminal `Buffer`.
+ struct Cell {
    /// The UTF-8 character or grapheme displayed in this cell.
    + symbol: String (" ")
    /// Visual style for this cell.
    + style: Style (.{})
    /// True for the trailing cell occupied by a 2-column wide character.
    + skip: bool (false)

    /// Returns a blank default cell (`" "` with `Style.default()`).
    + static fn empty() Cell {
        return Cell {}
    }

    /// Returns whether two cells have the same symbol, style, and skip flag.
    + fn equals(other: Cell) bool $eq {
        return this.skip == other.skip
            && this.symbol == other.symbol
            && this.style.equals(other.style)
    }

    /// Returns whether this cell is a default blank space.
    + fn is_empty_default() bool {
        return !this.skip && this.symbol == " " && this.style.is_default()
    }
}

/// A 2D grid of styled terminal cells supporting clipping, wide characters, and ANSI diffing.
+ class Buffer {
    /// Bounding rectangle of this buffer (origin is always `(0, 0)`).
    + area: Rect
    /// Row-major cell storage of length `area.width * area.height`.
    ~ cells: Array[Cell]

    /// Creates a blank buffer of `width` columns by `height` rows.
    + static fn new(width: uint, height: uint) Buffer {
        let total = width * height
        let cells = Array[Cell].new(total)
        let i: uint = 0
        let blank = Cell.empty()
        while i < total {
            cells.append(blank)
            i++
        }
        return Buffer {
            area: Rect.new(0, 0, width, height)
            cells: cells
        }
    }

    /// Creates a blank buffer matching the dimensions of `area`.
    + static fn empty(area: Rect) Buffer {
        return Buffer.new(area.width, area.height)
    }

    /// Buffer width in columns.
    + get width: uint {
        return this.area.width
    }

    /// Buffer height in rows.
    + get height: uint {
        return this.area.height
    }

    /// Resizes the buffer to `width` x `height` and clears all cells.
    + fn resize(width: uint, height: uint) {
        this.area = Rect.new(0, 0, width, height)
        let total = width * height
        this.cells = Array[Cell].new(total)
        let i: uint = 0
        let blank = Cell.empty()
        while i < total {
            this.cells.append(blank)
            i++
        }
    }

    /// Resets every cell in the buffer to a default space.
    + fn clear() {
        let blank = Cell.empty()
        let i: uint = 0
        let len = this.cells.length
        while i < len {
            this.cells[i] = blank
            i++
        }
    }

    /// Resets cells inside `rect` (clipped to the buffer) to default spaces.
    + fn clear_rect(rect: Rect) {
        this.fill(rect, " ", Style.default())
    }

    /// Returns whether `(x, y)` is inside the buffer bounds.
    + fn in_bounds(x: uint, y: uint) bool {
        return x < this.area.width && y < this.area.height
    }

    fn index_of(x: uint, y: uint) uint {
        return y * this.area.width + x
    }

    /// Returns the cell at `(x, y)`, or `null` if out of bounds.
    + fn get(x: uint, y: uint) ?Cell {
        if !this.in_bounds(x, y) : return null
        return this.cells[this.index_of(x, y)]
    }

    /// Sets a single cell at `(x, y)` with `symbol` and `style`.
    ///
    /// Out-of-bounds writes are ignored. Wide (2-column) characters mark the following cell
    /// as a continuation (`skip = true`) and are replaced with a space if they would overflow
    /// the right edge. Overwriting either half of an existing wide character clears its partner.
    + fn set_cell(x: uint, y: uint, symbol: String, style: Style) {
        if !this.in_bounds(x, y) : return
        let sym = symbol.bytes == 0 ? " " : symbol
        let w = symbol_width(sym)
        if w == 2 && x + 1 >= this.area.width {
            // Wide character doesn't fit at the right edge
            sym = " "
            w = 1
        }

        let idx = this.index_of(x, y)
        // If overwriting the trailing half of a wide char, clear its leading cell
        if this.cells[idx].skip && x > 0 {
            let left_idx = idx - 1
            let left = this.cells[left_idx]
            this.cells[left_idx] = Cell { symbol: " ", style: left.style, skip: false }
        }
        // If overwriting the leading half of an existing wide char, clear its trailing cell
        if x + 1 < this.area.width && this.cells[idx + 1].skip {
            let right_idx = idx + 1
            let right = this.cells[right_idx]
            this.cells[right_idx] = Cell { symbol: " ", style: right.style, skip: false }
        }

        this.cells[idx] = Cell { symbol: sym, style: style, skip: false }
        if w == 2 && x + 1 < this.area.width {
            // If the second cell was itself the start of a wide char, clear its trailing cell
            if x + 2 < this.area.width && this.cells[idx + 2].skip {
                let next_idx = idx + 2
                let next_cell = this.cells[next_idx]
                this.cells[next_idx] = Cell { symbol: " ", style: next_cell.style, skip: false }
            }
            this.cells[idx + 1] = Cell { symbol: "", style: style, skip: true }
        }
    }

    /// Patches `style` onto every cell inside `rect` (clipped to the buffer).
    + fn set_style(rect: Rect, style: Style) {
        let clip = this.area.intersection(rect)
        if clip.is_empty() : return
        let y = clip.y
        let y_end = clip.bottom()
        let x_end = clip.right()
        while y < y_end {
            let x = clip.x
            while x < x_end {
                let idx = this.index_of(x, y)
                let c = this.cells[idx]
                this.cells[idx] = Cell {
                    symbol: c.symbol
                    style: c.style.patch(style)
                    skip: c.skip
                }
                x++
            }
            y++
        }
    }

    /// Writes `text` starting at `(x, y)` with `style`, clipping at the buffer edge.
    ///
    /// Returns the number of columns written.
    + fn set_string(x: uint, y: uint, text: String, style: Style) uint {
        if !this.in_bounds(x, y) : return 0
        return this.set_string_clipped(x, y, this.area.width - x, text, style)
    }

    /// Writes `text` starting at `(x, y)` with `style`, clipped to `max_width` columns
    /// and the buffer bounds. Returns the number of columns written.
    + fn set_string_clipped(x: uint, y: uint, max_width: uint, text: String, style: Style) uint {
        if !this.in_bounds(x, y) || max_width == 0 : return 0
        let avail = this.area.width - x
        let limit = max_width < avail ? max_width : avail
        let col: uint = 0
        let pos: uint = 0
        let len = text.bytes

        while pos < len && col < limit {
            let cp, n = utf8_decode_at(text, pos)
            if n == 0 : break
            let w = char_width(cp)
            if w == 0 {
                pos += n
                continue
            }
            if col + w > limit : break
            let sym = text.range(pos, n)
            // Attach trailing combining marks to this grapheme cell
            let next_pos = pos + n
            while next_pos < len {
                let ncp, nn = utf8_decode_at(text, next_pos)
                if nn == 0 : break
                if char_width(ncp) != 0 || ncp < 0x20 : break
                next_pos += nn
            }
            if next_pos > pos + n {
                sym = text.range(pos, next_pos - pos)
            }
            this.set_cell(x + col, y, sym, style)
            col += w
            pos = next_pos
        }
        return col
    }

    /// Fills `rect` (clipped to the buffer) with `symbol` and `style`.
    + fn fill(rect: Rect, symbol: String, style: Style) {
        let clip = this.area.intersection(rect)
        if clip.is_empty() : return
        let y = clip.y
        let y_end = clip.bottom()
        let x_end = clip.right()
        while y < y_end {
            let x = clip.x
            while x < x_end {
                this.set_cell(x, y, symbol, style)
                x++
            }
            y++
        }
    }

    /// Copies dimensions and cell contents from `other` into `this`.
    + fn copy_from(other: Buffer) {
        if this.area.width != other.area.width || this.area.height != other.area.height {
            this.resize(other.area.width, other.area.height)
        }
        let i: uint = 0
        let len = other.cells.length
        while i < len {
            let c = other.cells[i]
            this.cells[i] = Cell {
                symbol: c.symbol
                style: c.style.clone()
                skip: c.skip
            }
            i++
        }
    }

    /// Returns the plain text of row `y` (without ANSI styles), or `""` if out of bounds.
    + fn row_text(y: uint) String {
        if y >= this.area.height : return ""
        let out = ByteBuffer.new(this.area.width)
        let x: uint = 0
        let w = this.area.width
        while x < w {
            let c = this.cells[this.index_of(x, y)]
            if !c.skip {
                out.write(c.symbol.bytes == 0 ? " " : c.symbol)
            }
            x++
        }
        return out.into_string()
    }

    /// Returns all rows joined by `"\n"`, useful for snapshot assertions in tests.
    + fn to_plain_string() String {
        let out = ByteBuffer.new((this.area.width + 1) * this.area.height)
        let y: uint = 0
        let h = this.area.height
        while y < h {
            if y > 0 : out.write_byte('\n')
            out.write(this.row_text(y))
            y++
        }
        return out.into_string()
    }

    /// Emits minimal ANSI escape sequences into `out` to update the terminal from `prev` to `this`.
    ///
    /// When `full_redraw` is `true` or the buffer dimensions changed, clears the screen first
    /// and redraws every non-blank cell.
    + fn diff_to_ansi(prev: Buffer, out: ByteBuffer, full_redraw: bool (false)) {
        let size_changed = this.area.width != prev.area.width || this.area.height != prev.area.height
        let do_full = full_redraw || size_changed
        let cur_style = Style.default()
        let has_cursor = false
        let last_x: uint = 0
        let last_y: uint = 0

        if do_full {
            out.write("\x1b[0m\x1b[2J\x1b[H")
            has_cursor = true
            last_x = 0
            last_y = 0
        }

        let h = this.area.height
        let w = this.area.width
        let y: uint = 0
        while y < h {
            let x: uint = 0
            while x < w {
                let idx = y * w + x
                let cell = this.cells[idx]
                if cell.skip {
                    x++
                    continue
                }

                let changed = false
                if do_full {
                    changed = !cell.is_empty_default()
                } else {
                    let prev_cell = prev.cells[idx]
                    changed = !cell.equals(prev_cell)
                }

                if changed {
                    if !has_cursor || last_y != y || last_x != x {
                        out.write("\x1b[")
                        out.write_uint_ascii(y + 1)
                        out.write_byte(';')
                        out.write_uint_ascii(x + 1)
                        out.write_byte('H')
                    }
                    cell.style.write_sgr_diff(cur_style, out)
                    cur_style = cell.style

                    let sym = cell.symbol.bytes == 0 ? " " : cell.symbol
                    out.write(sym)
                    let cw = symbol_width(sym)
                    last_x = x + cw
                    last_y = y
                    has_cursor = true
                }
                x++
            }
            y++
        }

        if !cur_style.is_default() {
            out.write("\x1b[0m")
        }
    }
}
