use tui

test "Block borders, titles, alignment, and inner rect" {
    let buf = tui.Buffer.new(14, 4)
    let blk = tui.Block {
        title: "Stats"
        title_alignment: .center
        borders: .rounded
        padding: tui.Padding.xy(1, 0)
    }
    let area = tui.Rect.new(0, 0, 14, 4)
    assert(blk.inner(area) == tui.Rect.new(2, 1, 10, 2))
    blk.render(area, buf)

    assert(buf.row_text(0) == "╭───Stats────╮")
    assert(buf.row_text(1) == "│            │")
    assert(buf.row_text(2) == "│            │")
    assert(buf.row_text(3) == "╰────────────╯")

    // Double and thick borders
    let buf2 = tui.Buffer.new(4, 2)
    let dbl = tui.Block { borders: .double }
    dbl.render(tui.Rect.new(0, 0, 4, 2), buf2)
    assert(buf2.row_text(0) == "╔══╗")
    assert(buf2.row_text(1) == "╚══╝")

    let thick = tui.Block { borders: .thick }
    thick.render(tui.Rect.new(0, 0, 4, 2), buf2)
    assert(buf2.row_text(0) == "┏━━┓")
    assert(buf2.row_text(1) == "┗━━┛")
}

test "Paragraph word wrapping, alignment, and scrolling" {
    let p = tui.Paragraph {
        text: "one two three four\nfive"
        wrap: true
    }
    let wrapped = p.wrapped_lines(10)
    assert(wrapped.length == 3)
    assert(wrapped[0] == "one two")
    assert(wrapped[1] == "three four")
    assert(wrapped[2] == "five")

    // Render with scroll = 1 and right alignment
    p.scroll = 1
    p.alignment = .right
    let buf = tui.Buffer.new(10, 2)
    p.render(tui.Rect.new(0, 0, 10, 2), buf)
    assert(buf.row_text(0) == "three four")
    assert(buf.row_text(1) == "      five")

    // Hard-break an overlong word cleanly
    let long_p = tui.Paragraph.new("abcdefghij")
    let broken = long_p.wrapped_lines(4)
    assert(broken.length == 3)
    assert(broken[0] == "abcd")
    assert(broken[1] == "efgh")
    assert(broken[2] == "ij")
}

test "List selection, highlight style, and viewport auto-scrolling" {
    let list = tui.List.new(Array[String]{ "Alpha", "Beta", "Gamma", "Delta", "Epsilon" })
    list.select(0)

    let buf = tui.Buffer.new(12, 3)
    let area = tui.Rect.new(0, 0, 12, 3)
    list.render(area, buf)
    assert(buf.row_text(0) == "> Alpha     ")
    assert(buf.row_text(1) == "  Beta      ")
    assert(buf.row_text(2) == "  Gamma     ")
    let sel_cell = buf.get(0, 0) ?! { assert(false) return }
    assert(sel_cell.style.reverse)

    // Move selection past viewport height -> auto-scrolls offset to 2
    list.select(4)
    buf.clear()
    list.render(area, buf)
    assert(list.offset == 2)
    assert(buf.row_text(0) == "  Gamma     ")
    assert(buf.row_text(1) == "  Delta     ")
    assert(buf.row_text(2) == "> Epsilon   ")

    // Move selection back up -> offset scrolls back up
    list.select_prev()
    list.select_prev()
    list.select_prev()
    buf.clear()
    list.render(area, buf)
    assert(list.offset == 1)
    assert(buf.row_text(0) == "> Beta      ")
}

test "Table headers, column constraints, selection, and scrolling" {
    let tbl = tui.Table {
        headers: Array[String]{ "ID", "Name" }
        rows: Array[Array[String]]{
            Array[String]{ "1", "Alice" },
            Array[String]{ "2", "Bob" },
            Array[String]{ "3", "Carol" },
            Array[String]{ "4", "Dave" }
        }
        widths: Array[tui.Constraint]{ tui.Constraint.fixed(3), tui.Constraint.fill(1) }
        column_spacing: 1
    }
    tbl.select(3)

    // Height 3 = 1 header + 2 visible body rows -> auto-scrolls to rows 2 & 3
    let buf = tui.Buffer.new(10, 3)
    tbl.render(tui.Rect.new(0, 0, 10, 3), buf)
    assert(buf.row_text(0) == "ID  Name  ")
    assert(buf.row_text(1) == "3   Carol ")
    assert(buf.row_text(2) == "4   Dave  ")

    let hdr = buf.get(0, 0) ?! { assert(false) return }
    assert(hdr.style.bold)
    let sel = buf.get(0, 2) ?! { assert(false) return }
    assert(sel.style.reverse)
}

test "Gauge smooth Unicode block fill and centered label" {
    // 10 cols at 55% = 5.5 cols -> 5 full blocks + half block "▌" (4/8ths)
    let g = tui.Gauge {
        ratio: 0.55
        show_percent: false
    }
    let buf = tui.Buffer.new(10, 1)
    g.render(tui.Rect.new(0, 0, 10, 1), buf)
    assert(buf.row_text(0) == "█████▌    ")

    // With default percentage label
    let g2 = tui.ProgressBar.percent(50)
    let buf2 = tui.Buffer.new(10, 1)
    g2.render(tui.Rect.new(0, 0, 10, 1), buf2)
    assert(buf2.row_text(0).contains("50%"))

    // Custom label
    let g3 = tui.Gauge { ratio: 1.0, label: "DONE" }
    let buf3 = tui.Buffer.new(8, 1)
    g3.render(tui.Rect.new(0, 0, 8, 1), buf3)
    assert(buf3.row_text(0) == "██DONE██")
}

test "Tabs rendering and cycling" {
    let tabs = tui.Tabs.new(Array[String]{ "Home", "Logs", "Help" })
    tabs.select_next()
    assert(tabs.selected == 1)

    let buf = tui.Buffer.new(20, 1)
    tabs.render(tui.Rect.new(0, 0, 20, 1), buf)
    assert(buf.row_text(0) == "Home │ Logs │ Help  ")

    // Active tab "Logs" starts at column 7 and has highlight style
    let inactive = buf.get(0, 0) ?! { assert(false) return }
    let active = buf.get(7, 0) ?! { assert(false) return }
    assert(!inactive.style.reverse)
    assert(active.style.reverse && active.style.bold)

    tabs.select_prev()
    tabs.select_prev()
    assert(tabs.selected == 2)
}

test "TextInput editing, UTF-8 cursor navigation, paste, and horizontal scroll" {
    let input = tui.TextInput.new("Type here...")

    // Empty input displays placeholder
    let buf = tui.Buffer.new(15, 1)
    input.render(tui.Rect.new(0, 0, 15, 1), buf)
    assert(buf.row_text(0) == "Type here...   ")

    // Type ASCII + UTF-8
    input.handle_key(tui.KeyEvent.char("H"))
    input.handle_key(tui.KeyEvent.char("i"))
    input.handle_key(tui.KeyEvent.char(" "))
    input.handle_key(tui.KeyEvent.char("é"))
    assert(input.value == "Hi é" && input.cursor == 4)

    // Move left, insert character in middle
    input.handle_key(tui.KeyEvent.code(.left))
    input.handle_key(tui.KeyEvent.char("!"))
    assert(input.value == "Hi !é" && input.cursor == 4)

    // Backspace deletes '!'
    input.handle_key(tui.KeyEvent.code(.backspace))
    assert(input.value == "Hi é" && input.cursor == 3)

    // Home + Delete removes 'H'
    input.handle_key(tui.KeyEvent.code(.home))
    input.handle_key(tui.KeyEvent.code(.delete))
    assert(input.value == "i é" && input.cursor == 0)

    // End + paste multiline text (newlines turned into spaces)
    input.handle_key(tui.KeyEvent.code(.end))
    input.handle_paste(tui.PasteEvent { text: "\nworld" })
    assert(input.value == "i é world")

    // Ctrl+W deletes previous word "world"
    input.handle_key(tui.KeyEvent.char("w", tui.Modifiers { ctrl: true }))
    assert(input.value == "i é ")

    // Horizontal scrolling when content exceeds width (width 5)
    input.set_value("abcdefghij")
    let narrow = tui.Buffer.new(5, 1)
    input.render(tui.Rect.new(0, 0, 5, 1), narrow)
    assert(input.scroll == 6)
    assert(narrow.row_text(0) == "ghij ")
    let cpos = input.cursor_screen_pos(tui.Rect.new(0, 0, 5, 1))
    assert(cpos.x == 4 && cpos.y == 0)
}

class CounterApp is tui.App {
    count: uint (0)
    last_resize: uint (0)

    + fn update(event: tui.Event) bool {
        let key = event.as_key()
        if isset(key) {
            if key.is_char("+") : this.count++
            if key.is_char("q") : return false
        }
        let res = event.as_resize()
        if isset(res) : this.last_resize = res.width
        return true
    }

    + fn view(frame: tui.Frame) {
        let p = tui.Paragraph.new("Count=" + this.count.to(String))
        frame.render(p, frame.area)
    }
}

test "run_app Elm/MVC loop with TestBackend" {
    let backend = tui.TestBackend.new(20, 3)
    backend.push_input("++")
    backend.resize(24, 4)
    backend.push_input("q")

    let term = tui.Terminal.new(backend)
    let app = CounterApp {}
    tui.run_app(term, app, tui.AppOptions {
        tick_ms: 0
        manage_terminal: true
        max_iterations: 20
    }) ! { assert(false) return }

    assert(app.count == 2)
    assert(app.last_resize == 24)
    assert(term.buffer.row_text(0).starts_with("Count=2"))
    // Terminal was cleanly closed on exit
    assert(!backend.raw_mode)
}

test "TextInput Ctrl+A/E/U/K shortcuts and Block cursor offset" {
    let input = tui.TextInput {
        block: tui.Block { title: "Input", borders: .plain }
    }
    input.set_value("hello world")
    // Ctrl+A moves to start, move right 5 -> before space
    input.handle_key(tui.KeyEvent.char("a", tui.Modifiers { ctrl: true }))
    assert(input.cursor == 0)
    input.handle_key(tui.KeyEvent.char("e", tui.Modifiers { ctrl: true }))
    assert(input.cursor == 11)
    // Move left 5 -> before "world"
    let i: uint = 0
    while i < 5 {
        input.handle_key(tui.KeyEvent.code(.left))
        i++
    }
    // Ctrl+K kills to end ("world")
    input.handle_key(tui.KeyEvent.char("k", tui.Modifiers { ctrl: true }))
    assert(input.value == "hello ")
    // Ctrl+U kills to start
    input.handle_key(tui.KeyEvent.char("u", tui.Modifiers { ctrl: true }))
    assert(input.value == "" && input.cursor == 0)

    input.set_value("abc")
    let area = tui.Rect.new(2, 4, 12, 3)
    let buf = tui.Buffer.new(20, 10)
    input.render(area, buf)
    // Inner starts at (3, 5); cursor after "abc" is at x=6, y=5
    let pos = input.cursor_screen_pos(area)
    assert(pos.x == 6 && pos.y == 5)
}

test "Table default auto widths inside a Block" {
    let tbl = tui.Table {
        headers: Array[String]{ "Key", "Val" }
        rows: Array[Array[String]]{
            Array[String]{ "env", "prod" }
        }
        block: tui.Block { title: "Config", borders: .plain }
    }
    let buf = tui.Buffer.new(16, 4)
    tbl.render(tui.Rect.new(0, 0, 16, 4), buf)
    assert(buf.row_text(0) == "┌Config────────┐")
    assert(buf.row_text(1).contains("Key") && buf.row_text(1).contains("Val"))
    assert(buf.row_text(2).contains("env") && buf.row_text(2).contains("prod"))
    assert(buf.row_text(3) == "└──────────────┘")
}
